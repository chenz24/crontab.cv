# Site canonical URL (used for SEO meta / og)
VITE_SITE_URL=https://crontab.cv

# Google Analytics 4 — Measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
VITE_GA_ID=

# Umami analytics — website id (UUID). Leave empty to disable.
VITE_UMAMI_WEBSITE_ID=
# Umami script src. Defaults to Umami Cloud if unset.
# For self-hosted: https://your-umami.example.com/script.js
VITE_UMAMI_SRC=https://cloud.umami.is/script.js
